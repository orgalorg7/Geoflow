ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=geoflow
POSTGRES_USER=geoflow
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+asyncpg://geoflow:change-me-in-production@postgres:5432/geoflow
ALEMBIC_DATABASE_URL=postgresql+psycopg://geoflow:change-me-in-production@postgres:5432/geoflow

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Replace this with a long random value before exposing the application.
AUTH_SECRET_KEY=development-only-change-this-secret-before-deployment
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_COOKIE_SECURE=false
